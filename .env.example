# Local secrets only. Do not commit a populated .env file.
PIG_FINSERV_FINGERPRINT_SALT=

# Optional Gemini commentary adapter. Core triage and reporting do not require it.
GEMINI_API_KEY=
# Docker Compose overrides this with the cost-efficient gemini-3.5-flash-lite.
GEMINI_MODEL=gemini-3.5-flash-lite
